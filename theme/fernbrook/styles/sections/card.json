{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Card",
	"slug": "card",
	"blockTypes": [ "core/group", "core/column" ],
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"border": { "radius": "14px", "color": "var(--wp--preset--color--line)", "width": "1px", "style": "solid" },
		"spacing": { "padding": { "top": "var(--wp--preset--spacing--40)", "bottom": "var(--wp--preset--spacing--40)", "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" } },
		"elements": { "link": { "color": { "text": "var(--wp--preset--color--bay)" } } }
	}
}
