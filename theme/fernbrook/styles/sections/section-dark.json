{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Dark section",
	"slug": "section-dark",
	"blockTypes": [ "core/group", "core/columns", "core/column" ],
	"styles": {
		"color": { "background": "var(--wp--preset--color--ink)", "text": "#E9EEF2" },
		"elements": {
			"heading": { "color": { "text": "var(--wp--preset--color--base)" } },
			"link": { "color": { "text": "var(--wp--preset--color--base)" }, ":hover": { "color": { "text": "var(--wp--preset--color--sun)" } } }
		}
	}
}
